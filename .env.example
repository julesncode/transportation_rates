# Конфигурация пайплайна. Скопируйте в .env и при необходимости измените.
# Значения по умолчанию рассчитаны на запуск внутри docker-compose.

# --- PostgreSQL 17 ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=deals_bigdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Источник данных ---
# Сколько сделок генерировать (в ТЗ — 300000; меньшее значение ускоряет локальные итерации)
N_PRICES=300000

# --- Аналитический слой ---
# Дата снимка источника. Задана в ТЗ (Вопрос 3), используется как "сейчас" для витрин и ML.
AS_OF_DATE=2026-10-26
# Окно свежести для reliability_level (Q4: месяц пересекается с [as_of - N дней; as_of])
FRESHNESS_WINDOW_DAYS=30
# Размер окна инкрементальной загрузки по loading_date, дней
ETL_WINDOW_DAYS=7

# --- ML ---
# Границы train/test не задаются вручную: они вычисляются от AS_OF_DATE
# по правилам ТЗ (train = as_of - 3 месяца .. as_of - 3 недели, test = до as_of).
RANDOM_SEED=42

# --- Прочее ---
LOG_LEVEL=INFO
